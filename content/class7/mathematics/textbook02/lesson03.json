    },
    {
      "heading": "ऋणात्मक घातांक",
      "content": "a⁻³ = 1/a³। उदाहरण: 2⁻³ = 1/2³ = 1/8।"
    },
    {
      "heading": "भिन्न के साथ ऋणात्मक घातांक",
      "content": "(2/3)⁻² = (3/2)² = 9/4। ऋणात्मक घातांक में आधार का व्युत्क्रम लेकर धनात्मक घात लगाया जा सकता है।"
    }
  ],
